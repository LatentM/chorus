# WalletConnect Cloud project id (required by RainbowKit; a placeholder works
# for MetaMask-only local testing)
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID
# Deployed contract address on Polygon Amoy (from contracts/scripts/deploy.js)
VITE_PLATFORM_ADDRESS=0x0000000000000000000000000000000000000000
# Pinata JWT for in-browser IPFS uploads (leave empty for mock CIDs)
VITE_PINATA_JWT=
# Optional: URL of the backend service (see backend/). When set, enables
# gasless voting via the relayer, server-side Pinata pinning (JWT stays off
# the browser), and the fast election indexer. Leave empty to run fully
# client-side with direct wallet transactions.
# Recommended. Enables gasless voting (default path) and hides voter wallets from the chain.
VITE_BACKEND_URL=http://localhost:8787
