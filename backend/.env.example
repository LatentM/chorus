PORT=8787
# Chain the relayer/indexer talk to (local node by default)
RPC_URL=http://127.0.0.1:8545
PLATFORM_ADDRESS=
# Wallet that PAYS GAS for voters (gasless voting). Fund it; keep it hot-wallet small.
RELAYER_PRIVATE_KEY=
# Server-side Pinata credential — never ships to the browser
PINATA_JWT=
DEPLOY_BLOCK=0
# Origins allowed to call this service (comma-separated). Add your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 when running behind a reverse proxy so per-IP rate limits work.
TRUST_PROXY=0
