# RPC endpoint for Polygon Amoy (default public one works)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# RPC endpoint for Polygon MAINNET (real funds!) — default public one works
POLYGON_RPC_URL=https://polygon-rpc.com
# Deployer / admin wallet private key (needs test POL from the Amoy faucet —
# or real POL for a Polygon mainnet deployment)
PRIVATE_KEY=
# Optional: for `hardhat verify`
POLYGONSCAN_API_KEY=
