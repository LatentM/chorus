# RPC endpoint for Polygon Amoy (default public one works)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# RPC endpoint for Sepolia — unlike Amoy there's no reliable public endpoint;
# get a free one from https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Deployer / admin wallet private key (needs Amoy MATIC or Sepolia ETH from a faucet)
PRIVATE_KEY=
# Optional: for `hardhat verify`
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=
